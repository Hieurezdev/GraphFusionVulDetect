# Host nginx site for https://scanguard.ptitai.org -> frontend container on 127.0.0.1:18510.
server {
    listen 80;
    server_name scanguard.ptitai.org;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name scanguard.ptitai.org;
    ssl_certificate /etc/letsencrypt/live/scanguard.ptitai.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scanguard.ptitai.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:18510;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
}
