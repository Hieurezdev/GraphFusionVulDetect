# Copy this file to .env and fill in your values
# GraphFusion Environment Variables Template

# AI/ML Configuration: Claude Haiku through the Astral X gateway (OpenAI-compatible) ...
CLAUDE_API_KEY="sk-your_claude_gateway_key"
BASE_URL="https://token.astralx.com.vn/v1"
MODEL_NAME="byok/astral-x/claude-haiku-5-5"

# ... or run a Hugging Face model on this server instead (the three API settings above are then ignored).
# Leave empty to use the API.
LOCAL_LLM_MODEL=""
# LOCAL_LLM_MODEL="suzeai/Qwen2.5-Coder-1.5B-explain-vul-wo-system"
# LOCAL_LLM_MAX_NEW_TOKENS=1024
# LOCAL_LLM_MAX_INPUT_TOKENS=8192

# Model Paths
EMBEDDING_MODEL_PATH="Quangnguyen711/codebert-solidity-time-dep"
GRAPH_VUL_MODEL_PATH="src/model/best_model_GCN_2L_max.pt"
NODE_VUL_MODEL_PATH="src/model/best_node_classifier_model.pt"

# Database Configuration
MONGODB_URL="mongodb://admin:your_password@mongodb:27017/graphfusion?authSource=admin"
MONGODB_HOST="mongodb"
MONGODB_PORT="27017"
MONGODB_DATABASE="graphfusion"
MONGODB_USERNAME="admin"
MONGODB_PASSWORD="your_mongodb_password"

# Redis Configuration
REDIS_URL="redis://redis:6379/0"
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_PASSWORD=""

# MinIO Configuration
MINIO_ENDPOINT="minio:9000"
MINIO_ACCESS_KEY="your_minio_access_key"
MINIO_SECRET_KEY="your_minio_secret_key"
MINIO_SECURE="false"
MINIO_BUCKET_DATA="graphfusion-data"
MINIO_BUCKET_MODELS="graphfusion-models"
MINIO_BUCKET_ARTIFACTS="graphfusion-artifacts"

# Application Configuration
ENVIRONMENT="development"
DEBUG="true"
LOG_LEVEL="debug"
SECRET_KEY="change_this_secret_key_in_production"
JWT_SECRET="change_this_jwt_secret_in_production"
JWT_EXPIRATION="24h"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_HOST="0.0.0.0"
API_PORT="8000"
API_WORKERS="1"
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://localhost:5173"

# File Upload Configuration
MAX_FILE_SIZE="100MB"
ALLOWED_EXTENSIONS=".sol,.txt,.json,.py"
UPLOAD_FOLDER="./uploads"

# Cache Configuration
CACHE_TTL="3600"
CACHE_PREFIX="gfd:"

# Security Configuration
BCRYPT_ROUNDS="12"
SESSION_TIMEOUT="1800"
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW="900"

# Bảng C improvements (docs/KE_HOACH_TRIEN_KHAI.md); defaults shown, uncomment to change
# Browser session cookie (2.5): set to true on the HTTPS server
AUTH_COOKIE_SECURE="false"
# AUTH_COOKIE_SAMESITE="strict"
# GET /metrics needs "Authorization: Bearer <token>" when set (1.10)
METRICS_TOKEN=""
# Share of unflagged functions sent to experts as blind random checks, consenting uploads only (1.4)
# RANDOM_AUDIT_RATE="0.05"
# Caches (1.5) and parallel explanations
# EMBEDDING_CACHE="true"
# EMBEDDING_CACHE_PATH="storage/embedding_cache.sqlite"
# RESULT_CACHE="true"
# LLM_MAX_CONCURRENCY="4"
# Calibration temperatures, tied to the checkpoint they were fitted on (1.7)
# CALIBRATION_PATH="src/infrastructure/analysis_model/calibration.json"
# Retrieval of similar judged functions for explanations and RefactorBot (1.8, 2.2)
# RAG_ENABLED="true"
# RAG_TOP_K="3"
# Active / shadow retrained checkpoints (1.9, 2.7)
# MODEL_REGISTRY_PATH="models/registry.json"
# Fix checks run in a separate, limited process (2.3)
# SANDBOX_ENABLED="true"
# SANDBOX_TIMEOUT="120"
# SANDBOX_MEMORY_MB="2048"

# MongoDB Express Configuration (Optional - for database management)
MONGO_EXPRESS_USERNAME="your_mongo_express_username"
MONGO_EXPRESS_PASSWORD="your_mongo_express_password"
MONGO_EXPRESS_PORT="8081"

# External Services (Optional)
WEBHOOK_URL=""
NOTIFICATION_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""

# Development specific
FRONTEND_URL="http://localhost:8080"
BACKEND_URL="http://localhost:8000"
