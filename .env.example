# Copy to .env; never commit credentials.
# GEMINI_API_KEY1 is the legacy setting for the OpenAI-compatible provider key.
GEMINI_API_KEY1=replace_with_your_astralx_key
BASE_URL=https://token.astralx.com.vn/v1
MODEL_NAME=byok/astral-x/claude-haiku-5-5
CHATBOT_MAX_TOKENS=16384
EMBEDDING_MODEL_PATH=Quangnguyen711/codebert-solidity-time-dep
GRAPH_VUL_MODEL_PATH=src/infrastructure/analysis_model/best_model_GCN_2L_max.pt
NODE_VUL_MODEL_PATH=src/infrastructure/analysis_model/best_node_classifier_model.pt
MONGODB_URL=mongodb://127.0.0.1:27018/graphfusion
MONGODB_DATABASE=graphfusion
SECRET_KEY=replace_with_a_random_secret
JWT_SECRET=replace_with_another_random_secret
DEVICE=cpu
# Docker publishes only this web port; MongoDB stays inside the compose network.
WEB_PORT=8080
